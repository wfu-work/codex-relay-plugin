{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay-protocol.dev/schemas/v1.json",
  "title": "Relay Protocol v1",
  "description": "Transport-only Relay v1 frames. Product messages stay opaque in stream.message.payload.",
  "oneOf": [
    { "$ref": "#/$defs/connectHello" },
    { "$ref": "#/$defs/connectWelcome" },
    { "$ref": "#/$defs/envelope" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "connectHello": {
      "type": "object",
      "required": ["version", "type", "requestId", "spaceId", "endpointId", "endpointType", "token", "endpointProof"],
      "properties": {
        "version": { "const": 1 },
        "type": { "const": "connect.hello" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "spaceId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "endpointId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "endpointType": { "type": "string", "minLength": 1, "maxLength": 256 },
        "endpointName": { "type": "string", "maxLength": 128 },
        "token": { "type": "string", "minLength": 1, "maxLength": 256 },
        "endpointProof": { "$ref": "#/$defs/endpointProof" },
        "capabilities": { "type": "array", "items": { "type": "string", "maxLength": 128 }, "maxItems": 64 },
        "metadata": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 512 } },
        "resume": { "$ref": "#/$defs/resume" }
      },
      "additionalProperties": true
    },
    "connectWelcome": {
      "type": "object",
      "required": ["version", "type", "connectionId", "sessionId", "spaceId", "endpointId", "maxFrameSize"],
      "properties": {
        "version": { "const": 1 },
        "type": { "const": "connect.welcome" },
        "requestId": { "type": "string", "maxLength": 256 },
        "connectionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "spaceId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "endpointId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "maxFrameSize": { "type": "integer", "minimum": 1 },
        "features": { "type": "array", "items": { "type": "string", "maxLength": 128 }, "maxItems": 64 }
      },
      "additionalProperties": true
    },
    "resume": {
      "type": "object",
      "required": ["sessionId", "lastAck"],
      "properties": {
        "sessionId": { "type": "string", "maxLength": 256 },
        "lastAck": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "endpointProof": {
      "type": "object",
      "required": ["algorithm", "publicKey", "issuedAt", "nonce", "signature"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "publicKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "issuedAt": { "type": "integer", "minimum": 1 },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,86}$" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": ["version", "type"],
      "properties": {
        "version": { "const": 1 },
        "type": { "enum": ["stream.open", "stream.message", "stream.ack", "stream.close", "ping", "pong"] },
        "messageId": { "type": "string", "maxLength": 256 },
        "requestId": { "type": "string", "maxLength": 256 },
        "correlationId": { "type": "string", "maxLength": 256 },
        "streamId": { "type": "string", "maxLength": 256 },
        "sequence": { "type": "integer", "minimum": 0 },
        "from": { "type": "string", "maxLength": 256 },
        "to": { "type": "string", "maxLength": 256 },
        "protocol": { "type": "string", "maxLength": 128 },
        "encrypted": { "type": "boolean" },
        "payload": {},
        "ack": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "maxLength": 2048 }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["version", "type", "code", "message"],
      "properties": {
        "version": { "const": 1 },
        "type": { "const": "relay.error" },
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "details": {}
      },
      "additionalProperties": true
    }
  }
}
